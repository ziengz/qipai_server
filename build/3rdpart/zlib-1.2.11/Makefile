	cd /d E:\qipai_server\build && $(MAKE) $(MAKESILENT) -f 3rdpart\zlib-1.2.11\CMakeFiles\zlib.dir\build.make 3rdpart/zlib-1.2.11/CMakeFiles/zlib.dir/source/zutil.c.s
.PHONY : source/zutil.c.s

